# Root .env template - Copy this to .env and fill in your actual values
# .env is gitignored and should contain your secrets
# .env is automatically sourced by python-dotenv 

# Environment selection (dev, prod, ci)
APP_ENV=dev

# Logging configuration (optional - defaults shown)
LOG_PRETTY_PRINT=false              # Use human-readable console output (true) or structured JSON (false)
LOG_SAVE_LOGS=true                  # Save logs to run.log file in run directory
LOG_CONSOLE_LEVEL=INFO              # Console log level (DEBUG, INFO, WARNING, ERROR)
LOG_FILE_LEVEL=DEBUG                # File log level (DEBUG, INFO, WARNING, ERROR)

# API Keys (Required for respective providers)
OPENROUTER_API_KEY=your_openrouter_key_here

# Database configuration (must match docker-compose.yml)
DATABASE_URL=postgresql://llm_ensemble:llm_ensemble@localhost:5432/llm_ensemble

