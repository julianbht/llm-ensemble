        doc_external_id: Document's external identifier
    
    Returns:
        Deterministic UUID for this aggregated judgement
    
    Example:
        >>> compute_aggregated_judgement_uuid("20240101_140000", "msmarco", "q1", "d1")
        UUID('...')
    """
    natural_key = f"{run_id}:{dataset}:{query_external_id}:{doc_external_id}"
    return uuid.uuid5(NAMESPACE_AGGREGATED_JUDGEMENT, natural_key)
