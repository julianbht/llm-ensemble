{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo 1: DB Reset",
      "type": "shell",
      "command": "make",
      "args": ["db-reset"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 2: Ingest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/ingest/adapters/driving/ingest_cli.py",
        "--input", "${workspaceFolder}/datasets/llm_judge_challenge_experiment",
        "--io-cfg", "llm_judge_challenge_to_db",
        "--run-name", "demo-ingest"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 3: Infer (mock GPT-5.1)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/infer/adapters/driving/infer_cli.py",
        "--model-cfg", "mock-demo",
        "--provider", "mock",
        "--prompt-template", "thomas-advanced-trec-v2",
        "--io-cfg", "db_to_db",
        "--input", "demo-ingest",
        "--run-name", "demo-infer-gpt",
        "--start-idx", "0",
        "--end-idx", "10",
        "--notes", "Offline demo: GPT-5.1 mock responses"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 4: Infer (mock Gemma 3 4B)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/infer/adapters/driving/infer_cli.py",
        "--model-cfg", "mock-gemma",
        "--provider", "mock",
        "--prompt-template", "thomas-advanced-trec-v2",
        "--io-cfg", "db_to_db",
        "--input", "demo-ingest",
        "--run-name", "demo-infer-gemma",
        "--start-idx", "0",
        "--end-idx", "10",
        "--notes", "Offline demo: Gemma 3 4B mock responses"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 5: Aggregate (majority vote)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/aggregate/adapters/driving/aggregate_cli.py",
        "--aggregation-strategy", "majority_vote_average",
        "--io-cfg", "db_to_db",
        "-i", "demo-infer-gpt",
        "-i", "demo-infer-gemma",
        "--run-name", "demo-aggregate",
        "--notes", "Offline demo: majority vote aggregation of GPT-5.1 and Gemma"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 6: Evaluate",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/evaluate/adapters/driving/evaluate_cli.py",
        "--io-cfg", "db_aggregate_to_json",
        "--input", "demo-aggregate",
        "--run-name", "demo-evaluate",
        "--notes", "Offline demo: evaluate aggregated results"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
