# ========================================================================
# Aggregation UUIDs
# ========================================================================

def compute_aggregated_score_uuid(
    aggregated_judgement_id: uuid.UUID,
    strategy: str
) -> uuid.UUID:
    """Compute deterministic UUID for an AggregatedScore.
    
    Args:
        aggregated_judgement_id: UUID of parent AggregatedJudgement
        strategy: Aggregation strategy name (e.g., 'weighted_majority')
    
    Returns:
        Deterministic UUID for this aggregated score
    
    Example:
        >>> parent_id = uuid.UUID('...')
        >>> compute_aggregated_score_uuid(parent_id, "weighted_majority")
        UUID('...')
    """
    natural_key = f"{aggregated_judgement_id}:{strategy}"
    return uuid.uuid5(NAMESPACE_AGGREGATED_SCORE, natural_key)


