    doc_external_id: str
) -> uuid.UUID:
    """Compute deterministic UUID for an LLMRequest.
    
    Args:
        run_id: Infer run identifier
        dataset: Dataset name
        query_external_id: Query's external identifier
        doc_external_id: Document's external identifier
    
    Returns:
        Deterministic UUID for this LLM request
    
    Example:
        >>> compute_llm_request_uuid("20240101_130000", "msmarco", "q1", "d1")
        UUID('...')
    """
    natural_key = f"{run_id}:{dataset}:{query_external_id}:{doc_external_id}"
    return uuid.uuid5(NAMESPACE_LLM_REQUEST, natural_key)


