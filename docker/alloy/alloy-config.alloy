// Discover all run.log files in the artifacts/runs directory
local.file_match "llm_logs" {
  path_targets = [{
    __path__ = "/var/log/llm-ensemble/**/run.log",
    __path_exclude__ = "",
  }]
}

// Read and tail the discovered log files
loki.source.file "llm_logs" {
  targets    = local.file_match.llm_logs.targets
  forward_to = [loki.process.parse_json.receiver]
}

// Process the logs: parse JSON and extract labels from log content
loki.process "parse_json" {
  forward_to = [loki.write.loki.receiver]

  // Parse JSON log entries - all metadata is in the logs themselves
  stage.json {
    expressions = {
      cli       = "cli",
      run_name  = "run_name",
      run_type  = "run_type",
      level     = "level",
      event     = "event",
      timestamp = "timestamp",
    }
  }

  // Add labels from parsed JSON fields
  stage.labels {
    values = {
      cli       = "cli",
      run_name  = "run_name",
      run_type  = "run_type",
      level     = "level",
      event     = "event",
    }
  }
}

// Write logs to Loki
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    job = "llm-logs",
  }
}
