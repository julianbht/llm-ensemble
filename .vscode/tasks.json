{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Infer",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/infer/adapters/driving/infer_cli.py",
        "--model-cfg", "openai-gpt-5.1",
        "--provider", "openrouter",
        "--prompt-template", "thomas-advanced-trec",
        "--io-cfg", "db_to_db",
        "--input", "20260107_014749",
        "--run-name", "noise-reference-ensemble-gpt-5-1-all-samples-start",
        "--notes", "Ensemble reference model. Rerun with the same settings as the first run with this model. Goal: determine ground noise.",
        "--official"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Evaluate",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/evaluate/adapters/driving/evaluate_cli.py",
        "--io-cfg", "db_infer_to_json",
        "--input", "noise-5-ensemble-5-ui-tars-1.5-7b-start",
        "--run-name", "noise-5-ensemble-5-ui-tars-1.5-7b-start",
        "--official",
        "--notes", "Evaluating the infer repeat runs. Goal: Determine the ground noise between the first and second repeat run. "
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Aggregate: Ensemble 1-5 (majority random vote)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/aggregate/adapters/driving/aggregate_cli.py",
        "--aggregation-strategy", "majority_vote_random",
        "--io-cfg", "db_to_db",
        "-i", "ensemble-1-google-gemma-3-4b-it",
        "-i", "ensemble-2-ministral-3b-2515",
        "-i", "ensemble-3-phi-4-multimodal-instruct",
        "-i", "ensemble-4-meta-llama-3.2-3b-instruct-start",
        "-i", "ensemble-5-ui-tars-1.5-7b-start",
        "--run-name", "-ensemble-1-to-5-majority-vote-random",
        "--notes", "Aggregating ensemble models 1 to 5 with majority voting and random tie breaking. Goal: produce a figure that shows aggrement metrics of the individual models, vs the reference-model vs the ensemble in total.",
        "--official"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
