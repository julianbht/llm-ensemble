{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo 1: DB Reset",
      "type": "shell",
      "command": "make",
      "args": ["db-reset"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 2: Ingest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/ingest/adapters/driving/ingest_cli.py",
        "--input-path", "${workspaceFolder}/datasets/llm_judge_challenge",
        "--io-cfg", "llm_judge_challenge_to_db",
        "--run-name", "demo-ingest",
        "--official"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Demo 3: Infer (mock GPT-5.1)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": [
        "${workspaceFolder}/src/llm_ensemble/infer/adapters/driving/infer_cli.py",
        "--model-cfg", "mock-demo",
        "--provider", "mock",
        "--prompt-template", "thomas-advanced-trec-v2",
        "--io-cfg", "db_to_db",
        "--input", "demo-ingest",
        "--run-name", "demo-infer",
        "--start-idx", "0",
        "--end-idx", "30",
        "--official",
        "--notes", "Offline demo using mock adapter with real GPT-5.1 responses"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": ["$python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
